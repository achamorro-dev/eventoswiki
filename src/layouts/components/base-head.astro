---
import { ClientRouter } from 'astro:transitions'
import { OTE_MEDIA_TYPE } from '@/ote/domain/ote-event'
import { OteUrls } from '@/ote/domain/ote-urls'

type BaseHeadProps = {
  title?: string
  description?: string
  image?: string
  url?: string
  ogType?: string
  jsonLd?: Record<string, unknown>
  feedUrl?: string
}

const {
  title = 'eventos.wiki',
  description = 'En eventos.wiki tendrás todos los eventos tecnológicos en un mismo lugar',
  image = 'https://eventos.wiki/og.jpg',
  url = 'https://eventos.wiki/',
  ogType = 'website',
  jsonLd,
  feedUrl = OteUrls.FEED,
} = Astro.props as BaseHeadProps

// `</script>` dentro de un título rompería el bloque JSON-LD: se escapa el `<`.
const jsonLdContent = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <meta name="apple-mobile-web-app-title" content="eventos.wiki" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:image" content={image} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="eventos.wiki" />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:site" content="@eventos_wiki" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@achamorro_dev" />
  <meta name="twitter:url" content={url} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <link rel="canonical" href={url} />
  <link rel="alternate" type={OTE_MEDIA_TYPE} href={feedUrl} title="Feed OpenTechEvents" />
  <title>{title}</title>
  {jsonLdContent && <script type="application/ld+json" set:html={jsonLdContent} />}
  <ClientRouter />

  <script is:inline>
    const darkClass = 'dark'
    const storageKey = 'theme-mode'

    const applyTheme = () => {
      const mode = localStorage.getItem(storageKey)

      if (mode === 'dark') {
        document.documentElement.classList.add(darkClass)
      } else if (mode === 'system' || !mode) {
        document.documentElement.classList.toggle(
          darkClass,
          window.matchMedia('(prefers-color-scheme: dark)').matches,
        )
      } else {
        document.documentElement.classList.remove(darkClass)
      }
    }

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      const mode = localStorage.getItem(storageKey)
      if (mode === 'system' || !mode) {
        document.documentElement.classList.toggle(darkClass, e.matches)
      }
    })

    document.addEventListener('astro:after-swap', applyTheme)
    applyTheme()
  </script>
  {import.meta.env.PROD && (
    <script defer src="https://analytics.eventos.wiki/script.js" data-website-id="5f3a0b4e-9154-4a67-8aa5-0f2080a167a6"></script>
  )}
</head>
<slot />
