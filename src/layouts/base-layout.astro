---
import ProvincesList from '@/provinces/presentation/server/components/provinces-list/provinces-list.astro'
import Footer from '@/ui/components/footer/footer.astro'
import Header from '@/ui/components/header/header.astro'
import SkipToContent from '@/ui/components/skip-to-content/skip-to-content.astro'
import { Toaster } from '@/ui/sonner'
import '../styles/global.css'
import BaseHead from './components/base-head.astro'

interface Props {
  title: string
  description?: string
  image?: string
  url?: string
  mainContentId?: string
  ogType?: string
  jsonLd?: Record<string, unknown>
  feedUrl?: string
}

const { title, description, image, url, mainContentId, ogType, jsonLd, feedUrl } = Astro.props
const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="es">
  <BaseHead
    title={`${title} - eventos.wiki`}
    description={description}
    image={image}
    url={url}
    ogType={ogType}
    jsonLd={jsonLd}
    feedUrl={feedUrl}
  />
  <body>
    <SkipToContent contentId={mainContentId} />
    <Header currentPath={currentPath} transition:persist />
    <slot />
    <Footer transition:persist>
      <ProvincesList />
    </Footer>
    <Toaster client:only transition:persist />
    <style is:global>
      @reference "../styles/global.css";

      html {
        @apply h-full scroll-smooth;
      }

      .skeleton {
        @apply animate-pulse bg-muted;
      }
    </style>
  </body>
</html>
