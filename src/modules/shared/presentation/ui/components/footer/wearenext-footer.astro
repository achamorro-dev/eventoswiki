---
import SirviendoCodigo from '@/ui/components/sponsors/sirviendo-codigo.astro'
---

<section class="initiative">
  <h2 class="initiative-title">Iniciativa impulsada por <a href="https://wearenext.es" class="font-bold underline" target="_blank" rel="noopener noreferrer">We Are Next</a></h2>
  <ul class="initiative-list">
    <li>
      <SirviendoCodigo />
    </li>
  </ul>
</section>

<style>
  @reference "../../../../../../styles/global.css";

  .initiative {
    @apply flex flex-col gap-4 pt-2;
  }

  .initiative-title {
    @apply text-muted-foreground text-[0.6875rem] font-medium tracking-[0.12em] uppercase;
  }

  .initiative-list {
    @apply flex list-none flex-col items-start gap-6 p-0;
  }

  /* La zona táctil vive en el contenedor: los logotipos son más bajos de 44 px. */
  .initiative-list li {
    @apply m-0 flex min-h-11 items-center md:min-h-0;
  }
</style>
