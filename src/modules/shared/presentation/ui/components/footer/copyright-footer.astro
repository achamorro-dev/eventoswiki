---
import { Heart } from '@/ui/icons'

const AUTHOR_URL = 'https://twitter.com/achamorro_dev'

const collaborators = [
  {
    name: 'salteadorneo',
    avatar: 'https://avatars.githubusercontent.com/u/4882454?s=64&v=4',
    github: 'https://github.com/salteadorneo',
  },
  {
    name: 'omorest',
    avatar: 'https://avatars.githubusercontent.com/u/32195484?s=64&v=4',
    github: 'https://github.com/omorest',
  },
  {
    name: 'svg153',
    avatar: 'https://avatars.githubusercontent.com/u/9192031?s=64&v=4',
    github: 'https://github.com/svg153',
  },
  {
    name: 'felixicaza',
    avatar: 'https://avatars.githubusercontent.com/u/38303370?s=64&v=4',
    github: 'https://github.com/felixicaza',
  },
  {
    name: 'alcastrob',
    avatar: 'https://avatars.githubusercontent.com/u/24974320?s=64&v=4',
    github: 'https://github.com/alcastrob',
  },
]

const currentYear = new Date().getFullYear()
---

<section class="copyright">
  <p class="copyright-legal">© {currentYear} eventos.wiki · Publicado bajo licencia MIT</p>
  <div class="copyright-credits">
    <p class="copyright-authorship">
      <span class="copyright-heart"><Heart size={14} aria-hidden="true" /></span>
      Hecho por <a href={AUTHOR_URL} class="copyright-author" target="_blank" rel="nofollow">@achamorro_dev</a> con
    </p>
    <ul class="copyright-avatars">
      {
        collaborators.map(collaborator => (
          <li class="copyright-avatar">
            <a href={collaborator.github} aria-label={collaborator.name} target="_blank" rel="nofollow">
              <img
                src={collaborator.avatar}
                alt=""
                height="32"
                width="32"
                loading="lazy"
                decoding="async"
                class="copyright-avatar-image"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  @reference "../../../../../../styles/global.css";

  .copyright {
    @apply border-border flex flex-col gap-4 border-t py-6 md:flex-row md:items-center md:justify-between md:gap-6;
  }

  .copyright-legal {
    @apply text-muted-foreground text-sm;
  }

  .copyright-credits {
    @apply flex flex-wrap items-center gap-x-3 gap-y-2;
  }

  .copyright-authorship {
    @apply text-muted-foreground flex items-center gap-1.5 text-sm;
  }

  .copyright-heart {
    @apply text-primary inline-flex;
  }

  .copyright-author {
    @apply text-foreground hover:text-primary no-underline transition-colors;
  }

  .copyright-avatars {
    @apply flex list-none items-center p-0;
  }

  .copyright-avatar {
    @apply m-0 -ml-2 first:ml-0;
  }

  .copyright-avatar-image {
    @apply border-background block size-8 rounded-full border-2;
  }
</style>
