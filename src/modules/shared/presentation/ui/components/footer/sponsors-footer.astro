---
import Codely from '@/ui/components/sponsors/codely.astro'
import NextDigital from '@/ui/components/sponsors/next-digital.astro'
---

<section class="sponsors">
  <h2 class="sponsors-title">Con el apoyo de</h2>
  <ul class="sponsors-list">
    <li>
      <Codely />
    </li>
    <li>
      <NextDigital />
    </li>
  </ul>
</section>

<style>
  @reference "../../../../../../styles/global.css";

  .sponsors {
    @apply flex flex-col gap-4 pt-2;
  }

  .sponsors-title {
    @apply text-muted-foreground text-[0.6875rem] font-medium tracking-[0.12em] uppercase;
  }

  .sponsors-list {
    @apply flex list-none flex-col items-start gap-6 p-0;
  }

  /* La zona táctil vive en el contenedor: los logotipos son más bajos de 44 px. */
  .sponsors-list li {
    @apply m-0 flex min-h-11 items-center md:min-h-0;
  }
</style>
