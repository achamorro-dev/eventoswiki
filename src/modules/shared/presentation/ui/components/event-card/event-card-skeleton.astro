---
import VisuallyHidden from '../visually-hidden/visually-hidden.astro'
---

<div class="event-card-skeleton">
  <VisuallyHidden>Cargando evento</VisuallyHidden>
  <div class="event-date"></div>
  <div class="event-body">
    <div class="event-tags"></div>
    <div class="event-title"></div>
    <div class="event-meta"></div>
  </div>
</div>

<style>
  @reference "../../../../../../styles/global.css";

  .event-card-skeleton {
    @apply relative flex min-h-[22rem] animate-pulse flex-col justify-end overflow-hidden rounded-xl bg-muted;
  }
  .event-date {
    @apply bg-overlay absolute left-4 top-4 h-11 w-16 rounded-lg opacity-80;
  }
  .event-body {
    @apply flex flex-col gap-2.5 p-[1.125rem];
  }
  .event-tags {
    @apply h-6 w-28 rounded-sm bg-white/25;
  }
  .event-title {
    @apply h-5 w-56 max-w-full rounded-sm bg-white/25;
  }
  .event-meta {
    @apply h-4 w-24 rounded-sm bg-white/20;
  }
</style>
