---
import { DateFormat, Datetime } from '@/shared/domain/datetime/datetime'
import { MapPin, Ticket } from '@/ui/icons'

const DAY_FORMAT = 'DD'
const SHORT_MONTH_FORMAT = 'MMM'
const YEAR_FORMAT = 'YYYY'

interface CardEvent {
  slug: string
  title: string
  image?: string
  tags: string[]
  tagColor: string
  startsAt: Date
  endsAt: Date
  location?: string | null
  minPrice?: number | null
}
interface Props {
  event: CardEvent
  classes?: string
  goToEvent: (slug: string) => string
}

const { event, classes, goToEvent } = Astro.props

const formatPrice = (price: number): string => {
  return new Intl.NumberFormat('es-ES', {
    style: 'currency',
    currency: 'EUR',
  }).format(price)
}

const startDay = Datetime.toDateString(event.startsAt, DAY_FORMAT)
const startMonth = Datetime.toDateString(event.startsAt, SHORT_MONTH_FORMAT)
const startYear = Datetime.toDateString(event.startsAt, YEAR_FORMAT)
const isCurrentYear = startYear === Datetime.toDateString(Datetime.now(), YEAR_FORMAT)
const startMonthLabel = isCurrentYear ? startMonth : `${startMonth} ${startYear}`
const lastDay = Datetime.isSameDay(event.startsAt, event.endsAt)
  ? null
  : Datetime.toDateString(event.endsAt, DateFormat.DD_MMM_YYYY)
const hasPrice = event.minPrice !== null && event.minPrice !== undefined
---

<a
  href={goToEvent(event.slug)}
  class:list={['event-card', classes]}
  title={event.title}
  aria-label={`Ver evento ${event.title}`}
>
  <img
    class="event-cover"
    src={event.image ?? '/not-found.jpg'}
    alt={`Foto de portada del evento ${event.title}`}
    loading="lazy"
    onerror="this.src='/not-found.jpg'"
    transition:name={`media-image-${event.slug}`}
  />
  <div class="event-scrim"></div>

  <time class="event-date" datetime={Datetime.toDateIsoString(event.startsAt)}>
    <span class="event-date-day">{startDay}</span>
    <span class="event-date-month">{startMonthLabel}</span>
  </time>

  {
    hasPrice && (
      <div class="event-price">
        <Ticket size={14} />
        <span>Desde {formatPrice(event.minPrice as number)}</span>
      </div>
    )
  }

  <div class="event-body">
    <div class="event-tags">
      {event.tags.map(tag => <span class="event-tag">{tag}</span>)}
    </div>
    <h3 class="event-title">{event.title}</h3>
    <div class="event-meta">
      {
        event.location && (
          <span class="event-place">
            <MapPin />
            {event.location}
          </span>
        )
      }
      {lastDay && <span class="event-until">Hasta el {lastDay}</span>}
    </div>
  </div>
</a>

<style>
  @reference "../../../../../../styles/global.css";

  .event-card {
    @apply relative flex min-h-[22rem] flex-col justify-end overflow-hidden rounded-xl bg-neutral-800 no-underline;

    @media (prefers-reduced-motion: no-preference) {
      &:hover .event-cover {
        transform: scale(1.06);
      }
    }
  }
  .event-cover {
    @apply absolute inset-0 h-full w-full object-cover;
    transition: transform 0.5s ease;
  }
  .event-scrim {
    @apply absolute inset-0;
    background: var(--scrim);
  }
  .event-date {
    @apply bg-overlay text-overlay-foreground absolute left-4 top-4 flex items-baseline gap-1.5 rounded-lg px-3 py-1.5;
  }
  .event-date-day {
    @apply text-xl font-semibold leading-none;
  }
  .event-date-month {
    @apply text-overlay-muted whitespace-nowrap text-[0.6875rem] uppercase tracking-[0.12em];
  }
  .event-price {
    @apply absolute right-4 top-4 flex items-center gap-1.5 rounded-full border border-white/20 bg-white/15 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm;
  }
  .event-body {
    @apply relative flex flex-col gap-2.5 p-[1.125rem];
  }
  .event-tags {
    @apply flex h-6 flex-wrap items-center gap-2 overflow-hidden;
  }
  .event-tag {
    @apply flex h-6 items-center rounded-sm bg-white/16 px-2.5 text-[0.6875rem] uppercase tracking-[0.08em] text-white;
  }
  .event-title {
    @apply m-0 line-clamp-2 text-[1.375rem] font-semibold leading-[1.16] tracking-tight text-white;
  }
  .event-meta {
    @apply flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.84rem] text-white/75;
  }
  .event-place {
    @apply flex shrink-0 items-center gap-1.5;
  }
  .event-until {
    @apply shrink-0;
  }
</style>
