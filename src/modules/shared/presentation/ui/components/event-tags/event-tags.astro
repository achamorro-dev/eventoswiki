---
import { Badge } from '@/ui/badge'

interface Props {
  tags: string[]
}

const { tags } = Astro.props
---

<div class="flex flex-wrap items-center gap-2" transition:animate="fade">
  {
    tags.map((t: string) => (
      <Badge variant="outline" className="tracking-[0.08em]">
        {t}
      </Badge>
    ))
  }
</div>
