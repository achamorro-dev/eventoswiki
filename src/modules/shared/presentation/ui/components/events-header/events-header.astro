---
import { Link } from '../link'
import { PageTitle } from '../page-title/page-title'

interface Props {
  title: string
  actionLink: string
  actionText: string
}

const { title, actionLink, actionText } = Astro.props
---

<header class="header">
  <PageTitle>{title}</PageTitle>
  <Link href={actionLink} className="action-link" variant="outline" size="sm">{actionText}</Link>
</header>
<slot />

<style>
  @reference "../../../../../../styles/global.css";

  .header {
    @apply flex w-full items-end justify-between gap-4;
  }
  .action-link {
    @apply mb-6 shrink-0;
  }
</style>
