---
interface Props {
  tabs: {
    label: string
    href: string
    isActive: boolean
  }[]
}

const { tabs } = Astro.props as Props
---

<nav class="tabs">
  <ul class="tabs-list">
    {
      tabs.map(tab => (
        <li data-state={tab.isActive ? 'active' : 'inactive'} class="tab">
          <a href={tab.href} class="tab-link">
            {tab.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  @reference "../../../../../../styles/global.css";

  .tabs {
    @apply border-border w-full overflow-x-auto border-b;
  }
  .tabs-list {
    @apply m-0 flex w-max list-none items-center gap-7 p-0;
  }
  .tab {
    @apply mb-0 border-b-2 border-transparent pb-3.5;
  }
  .tab[data-state='active'] {
    @apply border-b-primary;
  }
  .tab-link {
    @apply text-muted-foreground whitespace-nowrap text-[0.9375rem] no-underline;
  }
  .tab[data-state='active'] .tab-link {
    @apply text-foreground font-medium;
  }
</style>
