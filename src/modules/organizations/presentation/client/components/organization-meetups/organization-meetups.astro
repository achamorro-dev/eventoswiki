---
import { FindMeetupsQuery } from '@/meetups/application/find-meetups.query'
import { MeetupsContainer } from '@/meetups/di/meetups.container'
import type { Organization } from '@/organizations/domain/organization'
import { EmptyMessage } from '@/ui/components/empty-message/empty-message'
import EventsGrid from '@/ui/components/events-grid/events-grid.astro'
import { Link } from '@/ui/components/link'
import { ChalkboardTeacher } from '@/ui/icons'
import { Urls } from '@/ui/urls/urls'
import { SyncMeetupsButton } from '../sync-meetups-button/sync-meetups-button'

interface Props {
  organization: Organization
  isOrganizer: boolean
}

const { organization, isOrganizer } = Astro.props as Props
const paginatedMeetups = await MeetupsContainer.get(FindMeetupsQuery).execute({ organizationId: organization.id.value })
const hasMeetups = paginatedMeetups.data.length > 0
const canSyncMeetups = isOrganizer && Boolean(organization.meetup)
---

{
  isOrganizer && hasMeetups && (
    <div class="flex flex-wrap items-center justify-center gap-2">
      <Link href={Urls.CREATE_MEETUP(organization.handle)} variant="outline">
        Crear meetup
      </Link>
      {canSyncMeetups && (
        <SyncMeetupsButton
          client:load
          organizationId={organization.id.value}
          organizationHandle={organization.handle}
        />
      )}
    </div>
  )
}
<EventsGrid
  events={paginatedMeetups.data}
  page={paginatedMeetups.page}
  totalPages={paginatedMeetups.totalPages}
  goToEvent={Urls.MEETUP}
>
  <EmptyMessage
    slot="empty"
    icon={ChalkboardTeacher}
    title="No hay meetups"
    description="Cuando haya algún meetup dado de alto podrás verlo aquí."
  >
    {
      isOrganizer && (
        <div class="mt-4 flex flex-col items-center gap-2 sm:flex-row">
          <Link href={Urls.CREATE_MEETUP(organization.handle)} variant="outline">
            Crear meetup
          </Link>
          {canSyncMeetups && (
            <SyncMeetupsButton
              client:load
              organizationId={organization.id.value}
              organizationHandle={organization.handle}
            />
          )}
        </div>
      )
    }
  </EmptyMessage>
</EventsGrid>
