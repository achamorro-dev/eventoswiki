---
import { navigate } from 'astro:transitions/client'
import BaseLayout from '@/layouts/base-layout.astro'
import Layout from '@/layouts/layout.astro'
import { FindMeetupBySlugQuery } from '@/meetups/application/find-meetup-by-slug.query'
import { MeetupsContainer } from '@/meetups/di/meetups.container'
import { MeetupNotFound } from '@/meetups/domain/errors/meetup-not-found'
import type { Meetup } from '@/meetups/domain/meetup'
import { MeetupEditTabs } from '@/meetups/presentation/client/components/meetup-edit-tabs/meetup-edit-tabs'
import { OrganizationsContainer } from '@/organizations/di/organizations.container'
import { GetOrganizationByIdQuery } from '@/organizations/application/get-organization-by-id.query'
import { GetUserOrganizationsQuery } from '@/organizations/application/get-user-organizations.query'
import { OrganizerNotFound } from '@/organizations/domain/errors/organizer-not-found.error'
import { UserIsOrganizerEnsurer } from '@/organizations/application/user-is-organizer-ensurer.service'
import type { Organization } from '@/organizations/domain/organization'
import type { OrganizationComboboxOption } from '@/organizations/presentation/client/components/organization-combobox/organization-combobox'
import { ProvincesContainer } from '@/provinces/di/provinces.container'
import type { Province } from '@/provinces/domain/province'
import { CheckUserIsAdminByIdQuery } from '@/users/application/check-user-is-admin-by-id.query'
import { UserIsAdminEnsurer } from '@/users/application/user-is-admin-ensurer.service'
import { UserIsNotAdminError } from '@/users/domain/errors/user-is-not-admin.error'
import { UsersContainer } from '@/users/di/users.container'
import NotFound from '@/ui/components/not-found/not-found.astro'
import { PageTitle } from '@/ui/components/page-title/page-title'
import { Urls } from '@/ui/urls/urls'
import { GetProvincesQuery } from '@/provinces/application/get-provinces.query'

const year = Astro.params.year
const path = Astro.params.path

if (!year || !path) {
  navigate(Urls.HOME)
  return
}

const userId = Astro.locals.user?.id
const slug = `${year}/${path}`

let meetup: Meetup | undefined
let provinces: Province[] = []
let organization: Organization | undefined
let organizationOptions: OrganizationComboboxOption[] = []
let isAdmin = false
let canEdit = false

function toOrganizationOption(organization: Organization): OrganizationComboboxOption {
  return {
    id: organization.id.value,
    handle: organization.handle,
    name: organization.name,
    image: organization.image?.toString(),
  }
}

try {
  meetup = await MeetupsContainer.get(FindMeetupBySlugQuery).execute({ slug: slug })
  const getProvincesQuery = ProvincesContainer.get(GetProvincesQuery)
  provinces = await getProvincesQuery.execute()

  if (meetup && userId) {
    try {
      if (meetup.hasOrganization()) {
        await OrganizationsContainer.get(UserIsOrganizerEnsurer).ensure({ userId, organizationId: meetup.organizationId! })
      } else {
        await UsersContainer.get(UserIsAdminEnsurer).ensure({ userId })
      }
      canEdit = true
      isAdmin = await UsersContainer.get(CheckUserIsAdminByIdQuery).execute({ userId })

      if (meetup.organizationId) {
        organization = await OrganizationsContainer.get(GetOrganizationByIdQuery).execute({ id: meetup.organizationId })
      }

      const userOrganizations = await OrganizationsContainer.get(GetUserOrganizationsQuery).execute({ userId })
      organizationOptions = userOrganizations.map(toOrganizationOption)

      // La organización actual puede no estar entre las del usuario cuando edita un administrador
      if (organization && !organizationOptions.some(option => option.id === meetup?.organizationId)) {
        organizationOptions.unshift(toOrganizationOption(organization))
      }
    } catch (error) {
      if (!(error instanceof OrganizerNotFound) && !(error instanceof UserIsNotAdminError)) throw error
    }
  }
} catch (error) {
  switch (true) {
    case error instanceof MeetupNotFound:
      Astro.response.status = 404
      Astro.response.statusText = 'Not found'
      break
    default:
      Astro.response.status = 500
      Astro.response.statusText = 'Internal server error'
      break
  }
}
---

{
  meetup && canEdit ? (
    <>
      <Layout title={'Editar meetup'}>
        <article>
          <PageTitle>Editar meetup</PageTitle>
          <MeetupEditTabs
            client:only="react"
            meetup={meetup.toPrimitives()}
            provinces={provinces}
            organization={organization?.toPrimitives()}
            organizationOptions={organizationOptions}
            isAdmin={isAdmin}
          />
        </article>
      </Layout>
    </>
  ) : (
    <BaseLayout title="Meetup no encontrado">
      <NotFound title="Meetup no encontrado" />
    </BaseLayout>
  )
}
