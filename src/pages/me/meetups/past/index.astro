---
import Layout from '@/layouts/layout.astro'
import MyMeetupsPage from '@/meetups/presentation/client/pages/my-meetups-page/my-meetups-page.astro'
import { PageTitle } from '@/ui/components/page-title/page-title'
import { Urls } from '@/ui/urls/urls'

const userId = Astro.locals.user?.id

if (!userId) {
  return Astro.redirect(Urls.LOGIN)
}
---

<Layout title="Mis meetups - Pasados">
  <header class="mb-4">
    <PageTitle>Mis meetups</PageTitle>
  </header>
  <MyMeetupsPage userId={userId} activeTab="past" />
</Layout>
